# ── Contact form (Resend) ─────────────────────────────────────────────────────
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_key_here
# Optional: override the recipient address (defaults to richiechristiandeguzman11@gmail.com)
# CONTACT_TO_EMAIL=richiechristiandeguzman11@gmail.com

# ── Network ───────────────────────────────────────────────────────────────────
# Set to "mainnet" for Stellar Mainnet, "testnet" (default) for Testnet.
# When deployment.json exists, this is auto-injected at build time by next.config.ts.
# NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Soroban RPC
# NEXT_PUBLIC_SOROBAN_RPC=https://soroban-testnet.stellar.org

