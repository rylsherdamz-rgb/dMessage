# ── Stranger mode / on-device moderation (all optional) ───────────────────────
# Transformers.js text-classification model used for on-device moderation.
# NEXT_PUBLIC_MODERATION_MODEL=Xenova/toxic-bert
# Transformers.js image-classification model for video frames / DM images.
# NEXT_PUBLIC_IMAGE_MODERATION_MODEL=AdamCodd/vit-base-nsfw-detector
# Comma-separated Nostr relays for serverless matchmaking (defaults to Trystero's list).
# NEXT_PUBLIC_STRANGER_RELAYS=
# TURN server for users behind symmetric NATs (STUN-only works for most users).
# NEXT_PUBLIC_TURN_URL=
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_CREDENTIAL=
